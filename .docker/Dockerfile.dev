# Development Dockerfile with Air for hot reload
FROM golang:1.22-alpine

# Install Air for hot reload and PostgreSQL client for migrations
RUN go install github.com/cosmtrek/air@latest && \
    apk add --no-cache postgresql-client git

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Expose API port
EXPOSE 8080

# Run with Air (hot reload)
CMD ["air", "-c", ".air.toml"]
